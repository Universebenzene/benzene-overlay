description="check running sunloginclinet loop"
command="/opt/awesun/bin/awesun_daemon"
command_args="-m server -name awesun"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"

depend() {
	need net
	before runsunloginclient
}
